    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.1.2</version>
                <executions>
                    <execution>
                        <id>unpack-dependencies</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>unpack-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeArtifactIds>pn-commons</includeArtifactIds>
                            <outputDirectory>${project.build.directory}/dependency-resources</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>7.15.0</version>
                <executions>
                    <execution>
                        <id>manage-aggregate</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <inputSpec>${project.basedir}/docs/openapi/pn-apikey-manager-bo.yaml</inputSpec>
                            <generatorName>spring</generatorName>
                            <library>spring-boot</library>
                            <modelNameSuffix>Dto</modelNameSuffix>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <configOptions>
                                <basePackage>
                                    it.pagopa.pn.apikey.manager.generated.openapi.server.v1.aggregate
                                </basePackage>
                                <modelPackage>
                                    it.pagopa.pn.apikey.manager.generated.openapi.server.v1.aggregate.dto
                                </modelPackage>
                                <apiPackage>
                                    it.pagopa.pn.apikey.manager.generated.openapi.server.v1.aggregate.api
                                </apiPackage>
                                <configPackage>
                                    it.pagopa.pn.apikey.manager.generated.openapi.server.v1.aggregate.config
                                </configPackage>
                                <useSpringBoot3>true</useSpringBoot3>
                                <dateLibrary>java11</dateLibrary>
                                <delegatePattern>true</delegatePattern>
                                <interfaceOnly>true</interfaceOnly>
                                <annotationLibrary>none</annotationLibrary>
                                <documentationProvider>source</documentationProvider>
                                <openApiNullable>false</openApiNullable>
                                <reactive>true</reactive>
                                <skipDefaultInterface>false</skipDefaultInterface>
                                <useTags>true</useTags>
                            </configOptions>
                        </configuration>
                    </execution>
                    <execution>
                        <id>apikey-manager-internal</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <inputSpec>${project.basedir}/docs/openapi/pn-apikey-manager-internal.yaml</inputSpec>
                            <generatorName>spring</generatorName>
                            <library>spring-boot</library>
                            <modelNameSuffix>Dto</modelNameSuffix>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <configOptions>
                                <basePackage>
                                    it.pagopa.pn.apikey.manager.generated.openapi.server.v1
                                </basePackage>
                                <modelPackage>
                                    it.pagopa.pn.apikey.manager.generated.openapi.server.v1.dto
                                </modelPackage>
                                <apiPackage>
                                    it.pagopa.pn.apikey.manager.generated.openapi.server.v1.api
                                </apiPackage>
                                <configPackage>
                                    it.pagopa.pn.apikey.manager.generated.openapi.server.v1.config
                                </configPackage>
                                <useSpringBoot3>true</useSpringBoot3>
                                <dateLibrary>java11</dateLibrary>
                                <delegatePattern>true</delegatePattern>
                                <interfaceOnly>true</interfaceOnly>
                                <annotationLibrary>none</annotationLibrary>
                                <documentationProvider>source</documentationProvider>
                                <openApiNullable>false</openApiNullable>
                                <reactive>true</reactive>
                                <skipDefaultInterface>false</skipDefaultInterface>
                                <useTags>true</useTags>
                            </configOptions>
                        </configuration>
                    </execution>
                    <execution>
                        <id>apikey-prvt</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <inputSpec>${project.basedir}/docs/openapi/pn-apikey-manager-prvt.yaml</inputSpec>
                            <generatorName>spring</generatorName>
                            <library>spring-boot</library>
                            <modelNameSuffix>Dto</modelNameSuffix>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <configOptions>
                                <basePackage>
                                    it.pagopa.pn.apikey.manager.generated.openapi.server.v1.prvt
                                </basePackage>
                                <modelPackage>
                                    it.pagopa.pn.apikey.manager.generated.openapi.server.v1.prvt.dto
                                </modelPackage>
                                <apiPackage>
                                    it.pagopa.pn.apikey.manager.generated.openapi.server.v1.prvt.api
                                </apiPackage>
                                <configPackage>
                                    it.pagopa.pn.apikey.manager.generated.openapi.server.v1.prvt.config
                                </configPackage>
                                <useSpringBoot3>true</useSpringBoot3>
                                <dateLibrary>java11</dateLibrary>
                                <delegatePattern>true</delegatePattern>
                                <interfaceOnly>true</interfaceOnly>
                                <annotationLibrary>none</annotationLibrary>
                                <documentationProvider>source</documentationProvider>
                                <openApiNullable>false</openApiNullable>
                                <reactive>true</reactive>
                                <skipDefaultInterface>false</skipDefaultInterface>
                                <useTags>true</useTags>
                            </configOptions>
                        </configuration>
                    </execution>
                    <execution>
                        <id>apikey-manager-pg-internal</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <inputSpec>${project.basedir}/docs/openapi/pn-apikey-manager-pg-internal.yaml</inputSpec>
                            <generatorName>spring</generatorName>
                            <library>spring-boot</library>
                            <modelNameSuffix>Dto</modelNameSuffix>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <configOptions>
                                <basePackage>
                                    it.pagopa.pn.apikey.manager.generated.openapi.server.v1
                                </basePackage>
                                <modelPackage>
                                    it.pagopa.pn.apikey.manager.generated.openapi.server.v1.dto
                                </modelPackage>
                                <apiPackage>
                                    it.pagopa.pn.apikey.manager.generated.openapi.server.v1.api
                                </apiPackage>
                                <configPackage>
                                    it.pagopa.pn.apikey.manager.generated.openapi.server.v1.config
                                </configPackage>
                                <useSpringBoot3>true</useSpringBoot3>
                                <dateLibrary>java11</dateLibrary>
                                <delegatePattern>true</delegatePattern>
                                <interfaceOnly>true</interfaceOnly>
                                <annotationLibrary>none</annotationLibrary>
                                <documentationProvider>source</documentationProvider>
                                <openApiNullable>false</openApiNullable>
                                <reactive>true</reactive>
                                <skipDefaultInterface>false</skipDefaultInterface>
                                <useTags>true</useTags>
                            </configOptions>
